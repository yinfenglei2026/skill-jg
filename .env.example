# Docker Compose uses a separate local administrator to create least-privilege databases.
POSTGRES_IMAGE=postgres:16.4-alpine
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.0.7
POSTGRES_ADMIN_USERNAME=platform-admin
POSTGRES_ADMIN_PASSWORD=replace-with-local-admin-secret
GOVERNANCE_DB_USERNAME=governance
GOVERNANCE_DB_PASSWORD=replace-with-local-governance-secret
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-local-keycloak-secret
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-local-keycloak-admin-secret
KEYCLOAK_TEST_USER_PASSWORD=replace-with-local-test-user-password

# PostgreSQL is required outside the test profile.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/governance
SPRING_DATASOURCE_USERNAME=governance
SPRING_DATASOURCE_PASSWORD=replace-with-local-governance-secret

# Keycloak or another OIDC issuer. The control plane reads roles from realm_access.roles.
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=http://localhost:8081/realms/governance

# Reserved for the OCI/signature verification integration. Do not use mutable tags.
HARBOR_REGISTRY=registry.example.internal
