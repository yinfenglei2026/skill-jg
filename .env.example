# PostgreSQL is required outside the test profile.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/governance
SPRING_DATASOURCE_USERNAME=governance
SPRING_DATASOURCE_PASSWORD=replace-with-local-secret

# Keycloak or another OIDC issuer. The control plane reads roles from realm_access.roles.
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=https://keycloak.example.internal/realms/governance

# Reserved for the OCI/signature verification integration. Do not use mutable tags.
HARBOR_REGISTRY=registry.example.internal
